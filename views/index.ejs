<!-- Hero -->
<div class="text-center py-8 md:py-12 fade-up">
  <h1 class="text-4xl md:text-5xl font-extrabold mb-3">
    <span style="color: var(--primary)">أول مرّة</span>
  </h1>
  <p class="text-gray-400 mb-6 max-w-md mx-auto text-sm">كل شخص عنده تجربة مرّ بها لأول مرة — شارك وتعلم من تجارب الآخرين</p>
  <div class="flex justify-center gap-6 text-sm">
    <div class="text-center">
      <div class="text-xl font-bold text-brand-400"><%= totalStories %></div>
      <div class="text-gray-500 text-xs">تجربة</div>
    </div>
    <div class="w-px bg-dark-700"></div>
    <div class="text-center">
      <div class="text-xl font-bold text-yellow-400"><%= totalViews %></div>
      <div class="text-gray-500 text-xs">قراءة</div>
    </div>
    <div class="w-px bg-dark-700"></div>
    <div class="text-center">
      <div class="text-xl font-bold text-green-400"><%= totalReactions %></div>
      <div class="text-gray-500 text-xs">تفاعل</div>
    </div>
  </div>
</div>

<% if (typeof features !== 'undefined' && features.show_weekly_question && weeklyQuestion) { %>
<div class="max-w-2xl mx-auto mb-6 fade-up">
  <div class="relative rounded-2xl p-5 bg-dark-800/60 border border-dark-700/30">
    <div class="absolute top-3 left-3 text-xs bg-brand-600 text-white px-3 py-1 rounded-full font-bold">💡 سؤال الأسبوع</div>
    <p class="text-lg font-bold text-center mt-3 text-gray-100"><%= weeklyQuestion %></p>
  </div>
</div>
<% } %>

<!-- Categories (if enabled) -->
<% if (typeof features !== 'undefined' && features.show_categories) { %>
<div class="fade-up mb-6">
  <div class="flex flex-wrap justify-center gap-2">
    <a href="/?sort=<%= sort %>&q=<%= search %>" class="px-4 py-2 rounded-full text-sm font-semibold transition <%= !category ? 'bg-brand-600 text-white' : 'bg-dark-800/60 text-gray-400 border border-dark-700/40 hover:text-gray-300' %>">🌟 الكل</a>
    <% categories.forEach(function(c) { %>
      <a href="/?category=<%= encodeURIComponent(c.name) %>&sort=<%= sort %>&q=<%= search %>" class="px-4 py-2 rounded-full text-sm font-semibold transition <%= category === c.name ? 'bg-brand-600 text-white' : 'bg-dark-800/60 text-gray-400 border border-dark-700/40 hover:text-gray-300' %>">
        <%= c.icon %> <%= c.name %>
      </a>
    <% }); %>
  </div>
</div>
<% } %>

<!-- Sort -->
<% if (stories.length > 0) { %>
<div class="fade-up flex items-center justify-between gap-3 mb-5">
  <div class="flex gap-2">
    <% var sorts = [{v:'latest',l:'الأحدث'},{v:'views',l:'الأكثر مشاهدة'},{v:'reacts',l:'الأكثر تفاعلاً'},{v:'random',l:'عشوائي'}]; %>
    <% sorts.forEach(function(s) { %>
      <a href="/?sort=<%= s.v %>&category=<%= encodeURIComponent(category) %>&q=<%= search %>" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition <%= sort === s.v ? 'bg-dark-700 text-white' : 'text-gray-500 hover:text-gray-300' %>"><%= s.l %></a>
    <% }); %>
  </div>
  <% if (category || search) { %>
    <a href="/" class="text-xs text-brand-400">✕ مسح</a>
  <% } %>
</div>
<% } %>

<!-- Stories Feed -->
<% if (stories.length === 0) { %>
<div class="text-center py-16 text-gray-500 fade-up">
  <div class="text-5xl mb-4">📝</div>
  <p class="text-lg mb-2"><%= search ? 'لا توجد نتائج' : 'لا توجد تجارب بعد' %></p>
  <p class="text-sm text-gray-600 mb-6"><%= search ? 'جرّب كلمات بحث مختلفة' : 'كن أول من يشارك تجربته!' %></p>
  <button onclick="openSubmitModal()" class="bg-brand-600 hover:bg-brand-700 px-8 py-3 rounded-full font-bold transition-all" style="color:#fff !important">✍️ شارك الآن</button>
</div>
<% } else { %>
<div id="storiesGrid">
<% stories.forEach(function(s, idx) { %>
  <%
    var doneItems = (s.done_regrets || '').split('|||').filter(Boolean);
    var notDoneItems = (s.notdone_regrets || '').split('|||').filter(Boolean);
    var showSeparate = typeof features !== 'undefined' && features.show_separate_regrets;
    var displayText = '';
    if (s.comment) { displayText = s.comment; }
    else if (!showSeparate) {
      var parts = [];
      doneItems.forEach(function(d) { parts.push('😔 ' + d); });
      notDoneItems.forEach(function(d) { parts.push('✨ ' + d); });
      displayText = parts.join('\n');
    }
  %>
  <a href="/story/<%= s.id %>" class="story-card bg-dark-800/40 border border-dark-700/30 rounded-2xl p-5 fade-up flex flex-col hover:border-brand-500/30 transition group">
    <!-- Text (prominent) -->
    <% if (displayText) { %>
      <p class="text-gray-200 text-base leading-relaxed flex-1 whitespace-pre-line"><%= displayText.length > 200 ? displayText.substring(0, 200) + '...' : displayText %></p>
    <% } %>

    <% if (showSeparate && doneItems.length) { %>
    <div class="mt-2 flex flex-wrap gap-1">
      <% doneItems.slice(0,2).forEach(function(d) { %>
        <span class="regret-tag bg-brand-900/25 text-brand-300 border border-brand-800/20 text-xs"><%= d %></span>
      <% }); %>
    </div>
    <% } %>
    <% if (showSeparate && notDoneItems.length) { %>
    <div class="mt-1 flex flex-wrap gap-1">
      <% notDoneItems.slice(0,2).forEach(function(d) { %>
        <span class="regret-tag bg-yellow-900/15 text-yellow-300 border border-yellow-800/15 text-xs"><%= d %></span>
      <% }); %>
    </div>
    <% } %>

    <!-- Reactions bar -->
    <div class="flex items-center justify-around mt-4 pt-3 border-t border-dark-700/30">
      <span class="react-btn text-xs flex items-center gap-1 cursor-pointer transition select-none" data-sid="<%= s.id %>" data-type="relatable" onclick="event.preventDefault();event.stopPropagation();toggleReact(this)">
        <span class="react-emoji">🫂</span> <span class="react-count text-gray-500"><%= s.reactions && s.reactions.relatable || 0 %></span>
      </span>
      <span class="react-btn text-xs flex items-center gap-1 cursor-pointer transition select-none" data-sid="<%= s.id %>" data-type="sympathy" onclick="event.preventDefault();event.stopPropagation();toggleReact(this)">
        <span class="react-emoji">❤️</span> <span class="react-count text-gray-500"><%= s.reactions && s.reactions.sympathy || 0 %></span>
      </span>
      <span class="react-btn text-xs flex items-center gap-1 cursor-pointer transition select-none" data-sid="<%= s.id %>" data-type="motivated" onclick="event.preventDefault();event.stopPropagation();toggleReact(this)">
        <span class="react-emoji">💪</span> <span class="react-count text-gray-500"><%= s.reactions && s.reactions.motivated || 0 %></span>
      </span>
      <span onclick="event.preventDefault();event.stopPropagation();window.location.href='/story/<%= s.id %>#comments'" class="text-xs text-gray-400 flex items-center gap-1 hover:text-gray-200 transition cursor-pointer">💬 <span class="text-gray-500"><%= s.comment_count || 0 %></span></span>
    </div>
    <!-- Author & date -->
    <div class="flex items-center gap-2 mt-2">
      <span class="text-xs text-gray-500"><%= s.hide_name ? '👤 مجهول' : s.name %></span>
      <span class="text-xs text-gray-600">· <%= new Date(s.created_at).toLocaleDateString(dateFormat === 'hijri' ? 'ar-SA' : 'ar-EG') %></span>
    </div>
  </a>
  <% }); %>
</div>
<% } %>

<!-- Infinite scroll sentinel + state -->
<div id="infiniteSentinel"></div>
<div id="loadMoreContainer" class="text-center mt-6">
  <% if (hasMore) { %>
  <div id="loadingIndicator" class="hidden py-4">
    <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-brand-500"></div>
  </div>
  <% } else { %>
  <p class="text-gray-500 text-sm">✨ لا مزيد من المشاركات</p>
  <% } %>
</div>
<script>
window._awwal_pageState = {
  nextPage: <%= hasMore ? currentPage + 1 : null %>,
  sort: '<%= sort %>',
  category: '<%= category %>',
  search: '<%= search %>',
  loading: false,
  done: <%= !hasMore %>
};
</script>

<!-- Submit Modal -->
<div id="submitModal" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center">
  <div class="absolute inset-0 bg-black/60" onclick="closeSubmitModal()"></div>
  <div class="relative bg-dark-900 border border-dark-700 rounded-t-3xl sm:rounded-2xl w-full max-w-md max-h-[85vh] overflow-y-auto p-5 sm:p-6 animate-slide-up">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold">شارك تجربتك ✍️</h2>
      <button onclick="closeSubmitModal()" class="text-gray-500 hover:text-gray-300 text-xl leading-none w-8 h-8 flex items-center justify-center">✕</button>
    </div>

    <form id="modalSubmitForm" class="space-y-3">
      <textarea name="simple_text" id="modalText" rows="5" required placeholder="اكتب تجربتك هنا..." class="w-full bg-dark-800 border border-dark-700 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-500 transition resize-none"></textarea>
      <input type="text" name="name" id="modalName" required placeholder="الاسم *" class="w-full bg-dark-800 border border-dark-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-brand-500 transition">
      <input type="email" name="email" id="modalEmail" required placeholder="البريد الإلكتروني *" class="w-full bg-dark-800 border border-dark-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-brand-500 transition">
      <label class="flex items-center gap-2 cursor-pointer py-1">
        <input type="checkbox" name="hide_name" value="1" class="accent-brand-500 w-4 h-4">
        <span class="text-sm text-gray-400">إخفاء هويتي 👤</span>
      </label>

      <% if (typeof features !== 'undefined' && features.show_advanced_submit) { %>
      <button type="button" onclick="document.getElementById('advancedSection').classList.toggle('hidden');this.querySelector('span').textContent = document.getElementById('advancedSection').classList.contains('hidden') ? '▼' : '▲'" class="text-sm text-brand-400 hover:text-brand-300 transition py-1">
        خيارات إضافية <span>▼</span>
      </button>
      <div id="advancedSection" class="hidden space-y-3 pt-3 border-t border-dark-700/30">
        <div>
          <label class="block text-xs text-gray-500 mb-1">التصنيف</label>
          <div class="flex flex-wrap gap-2">
            <% (categories || []).forEach(function(c) { %>
              <label class="cursor-pointer">
                <input type="radio" name="category" value="<%= c.name %>" class="hidden peer" <%= c.name === 'شخصي' ? 'checked' : '' %>>
                <div class="peer-checked:cat-active bg-dark-700/50 border border-dark-600/40 rounded-lg px-3 py-1.5 text-xs text-center transition hover:bg-dark-700">
                  <%= c.icon %> <%= c.name %>
                </div>
              </label>
            <% }); %>
          </div>
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">😔 ندم عليها</label>
          <input type="text" name="done1" placeholder="مثال: تأخرت في الدراسة" class="w-full bg-dark-800 border border-dark-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-brand-500 transition">
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">✨ تمنيت لو فعلتها</label>
          <input type="text" name="notdone1" placeholder="مثال: لو سافرت أكثر" class="w-full bg-dark-800 border border-dark-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-brand-500 transition">
        </div>
      </div>
      <% } %>

      <input type="hidden" name="simple_mode" value="1">
      <button type="submit" id="modalSubmitBtn" class="w-full bg-brand-600 hover:bg-brand-700 py-3 rounded-xl font-bold transition-all" style="color:#fff !important">🚀 إرسال</button>
    </form>
  </div>
</div>

<style>
  @keyframes slide-up {
    from { transform: translateY(100%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  .animate-slide-up { animation: slide-up 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
  @media (min-width: 640px) {
    .animate-slide-up { animation: none; }
  }
</style>

<script>
function openSubmitModal() {
  document.getElementById('submitModal').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
  setTimeout(() => document.getElementById('modalText').focus(), 100);
  var fab = document.getElementById('fabBtn');
  if (fab) fab.classList.remove('fab-pulse');
}
function closeSubmitModal() {
  document.getElementById('submitModal').classList.add('hidden');
  document.body.style.overflow = '';
}

// Modal form submit via AJAX
document.getElementById('modalSubmitForm').addEventListener('submit', function(e) {
  e.preventDefault();
  const form = this;
  const name = form.name.value.trim();
  const text = form.simple_text.value.trim();
  if (!name || !text) { showToast('يرجى ملء الحقول المطلوبة', 'error'); return; }

  const btn = document.getElementById('modalSubmitBtn');
  btn.disabled = true;
  btn.textContent = '⏳ جاري الإرسال...';

  // If advanced fields are visible and filled, switch to advanced mode
  const done1 = form.done1 ? form.done1.value.trim() : '';
  const notdone1 = form.notdone1 ? form.notdone1.value.trim() : '';
  const isAdvanced = done1 || notdone1;

  const params = new URLSearchParams(new FormData(form));
  if (isAdvanced) {
    // Merge main text with comment field
    const extraComment = form.comment ? form.comment.value.trim() : '';
    const combinedComment = extraComment ? text + '\n\n' + extraComment : text;
    params.set('simple_mode', '0');
    params.set('comment', combinedComment);
    params.set('simple_text', '');
  }

  fetch('/submit', {
    method: 'POST',
    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
    body: params
  })
  .then(async r => {
    const text = await r.text();
    try { return JSON.parse(text); } catch(e) { return { ok: false, error: text.substring(0, 100) }; }
  })
  .then(data => {
    if (data.ok) {
      closeSubmitModal();
      form.reset();
      // Redirect to confirmation page
      window.location.href = '/submit-success';
    } else {
      showToast(data.error || 'حدث خطأ، حاول مرة أخرى', 'error');
    }
  })
  .catch(() => {
    showToast('خطأ في الاتصال، حاول مرة أخرى', 'error');
  })
  .finally(() => {
    btn.disabled = false;
    btn.textContent = '🚀 إرسال';
  });
});

// Favorites
function getFavorites(){try{return JSON.parse(localStorage.getItem('awwal_favorites')||'[]')}catch{return[]}}
function isFavorite(id){return getFavorites().includes(Number(id))}
function toggleFavorite(id){let f=getFavorites();id=Number(id);if(f.includes(id)){f=f.filter(x=>x!==id);showToast('تم الإزالة من المفضلة','info')}else{f.push(id);showToast('تم الإضافة للمفضلة ❤️','success')}localStorage.setItem('awwal_favorites',JSON.stringify(f));updateFavButtons()}
function updateFavButtons(){document.querySelectorAll('.fav-btn').forEach(b=>{b.textContent=isFavorite(b.dataset.id)?'❤️':'🤍'})}
updateFavButtons();

// Category radio active state
function updateCategoryStyles() {
  document.querySelectorAll('input[name="category"]').forEach(r => {
    const inner = r.closest('label') ? r.closest('label').querySelector('div') : null;
    if (inner) {
      if (r.checked) {
        inner.classList.add('cat-selected');
      } else {
        inner.classList.remove('cat-selected');
      }
    }
  });
}
document.querySelectorAll('input[name="category"]').forEach(r => {
  r.addEventListener('change', updateCategoryStyles);
});
updateCategoryStyles();

// ===== Infinite Scroll =====
function loadMorePosts() {
  var state = window._awwal_pageState;
  if (!state || state.loading || state.done || !state.nextPage) return;

  state.loading = true;
  var indicator = document.getElementById('loadingIndicator');
  if (indicator) indicator.classList.remove('hidden');

  var url = '/?page=' + state.nextPage + '&sort=' + state.sort + '&category=' + encodeURIComponent(state.category) + '&q=' + encodeURIComponent(state.search) + '&ajax=1';

  fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
    .then(function(r) { return r.text(); })
    .then(function(html) {
      var parser = new DOMParser();
      var doc = parser.parseFromString(html, 'text/html');
      // Extract cards from the fetched page's grid
      var newCards = doc.querySelectorAll('#storiesGrid > .story-card');
      var grid = document.getElementById('storiesGrid');

      if (newCards.length === 0) {
        // No more posts
        state.done = true;
        state.loading = false;
        var container = document.getElementById('loadMoreContainer');
        if (container) container.innerHTML = '<p class="text-gray-500 text-sm">✨ لا مزيد من المشاركات</p>';
        return;
      }

      // Append new cards directly to the grid — CSS columns handles layout
      newCards.forEach(function(card) {
        grid.appendChild(card);
      });

      // Observe new cards for fade-up animation
      newCards.forEach(function(card) {
        if (window._fadeObserver) {
          window._fadeObserver.observe(card);
        } else {
          card.classList.add('visible');
        }
      });

      // Re-init reaction buttons for new cards
      initReactButtons(grid);

      // Update pagination state from the fetched page
      var fetchedState = null;
      try {
        var stateScript = doc.querySelector('script:not([src])');
        if (stateScript) {
          var match = stateScript.textContent.match(/window\._awwal_pageState\s*=\s*({[\s\S]*?});/);
          if (match) fetchedState = JSON.parse(match[1]);
        }
      } catch(e) {}

      if (fetchedState && !fetchedState.done) {
        state.nextPage = fetchedState.nextPage;
        state.loading = false;
      } else {
        // Check if there's a sentinel + state on fetched page
        var fetchedSentinel = doc.getElementById('infiniteSentinel');
        if (fetchedSentinel) {
          // Try to parse the page state
          var hasMoreScript = doc.querySelector('#loadMoreContainer');
          if (hasMoreScript && hasMoreScript.textContent.indexOf('لا مزيد') !== -1) {
            state.done = true;
            state.nextPage = null;
            var container = document.getElementById('loadMoreContainer');
            if (container) container.innerHTML = '<p class="text-gray-500 text-sm">✨ لا مزيد من المشاركات</p>';
          } else {
            state.nextPage = state.nextPage + 1;
            state.loading = false;
          }
        } else {
          state.done = true;
          state.nextPage = null;
          var container = document.getElementById('loadMoreContainer');
          if (container) container.innerHTML = '<p class="text-gray-500 text-sm">✨ لا مزيد من المشاركات</p>';
        }
      }

      if (indicator) indicator.classList.add('hidden');
    })
    .catch(function() {
      state.loading = false;
      if (indicator) indicator.classList.add('hidden');
      showToast('خطأ في التحميل', 'error');
    });
}

// IntersectionObserver for infinite scroll
var sentinel = document.getElementById('infiniteSentinel');
if (sentinel && window._awwal_pageState && !window._awwal_pageState.done) {
  var scrollObserver = new IntersectionObserver(function(entries) {
    if (entries[0].isIntersecting) {
      loadMorePosts();
    }
  }, { rootMargin: '300px' });
  scrollObserver.observe(sentinel);
}

// ===== Unified Reaction System =====
var REACT_STORE = 'awwal_reactions';
var _reactState = {};
try { _reactState = JSON.parse(localStorage.getItem(REACT_STORE) || '{}'); } catch(e) {}
function _saveReacts() { localStorage.setItem(REACT_STORE, JSON.stringify(_reactState)); }
function _hasReacted(sid, t) { return ((_reactState[sid] || []).indexOf(t) !== -1); }

var REACT_STYLES = {
  relatable: { active: 'react-active-relatable' },
  sympathy:  { active: 'react-active-sympathy' },
  motivated: { active: 'react-active-motivated' }
};

function _applyReactActive(el, type, on) {
  var cls = REACT_STYLES[type];
  if (!cls) return;
  if (on) {
    el.classList.add('react-active', cls.active);
  } else {
    el.classList.remove('react-active', cls.active);
  }
}

function toggleReact(el) {
  var sid = el.dataset.sid;
  var type = el.dataset.type;
  if (!sid || !type) return;
  if (el.dataset.busy === '1') return;
  el.dataset.busy = '1';

  var countEl = el.querySelector('.react-count');
  var oldCount = parseInt(countEl.textContent) || 0;
  var had = _hasReacted(sid, type);
  var action = had ? 'remove' : 'add';

  // Optimistic update
  countEl.textContent = had ? Math.max(0, oldCount - 1) : oldCount + 1;
  _applyReactActive(el, type, !had);

  // Update localStorage
  if (!_reactState[sid]) _reactState[sid] = [];
  if (had) {
    _reactState[sid] = _reactState[sid].filter(function(x) { return x !== type; });
  } else {
    if (_reactState[sid].indexOf(type) === -1) _reactState[sid].push(type);
  }
  _saveReacts();

  fetch('/react', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ story_id: sid, type: type, action: action })
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    el.dataset.busy = '0';
    if (!d.ok) {
      // Revert
      countEl.textContent = oldCount;
      _applyReactActive(el, type, had);
      if (had) { if (_reactState[sid].indexOf(type) === -1) _reactState[sid].push(type); }
      else { _reactState[sid] = _reactState[sid].filter(function(x) { return x !== type; }); }
      _saveReacts();
    } else if (d.counts) {
      // Server-authoritative count
      countEl.textContent = d.counts[type] || 0;
    }
  })
  .catch(function() {
    el.dataset.busy = '0';
    countEl.textContent = oldCount;
    _applyReactActive(el, type, had);
    if (had) { if (_reactState[sid].indexOf(type) === -1) _reactState[sid].push(type); }
    else { _reactState[sid] = _reactState[sid].filter(function(x) { return x !== type; }); }
    _saveReacts();
  });
}

// Init all reaction buttons from localStorage
function initReactButtons(scope) {
  (scope || document).querySelectorAll('.react-btn').forEach(function(el) {
    var sid = el.dataset.sid || el.dataset.story;
    var type = el.dataset.type;
    if (sid && type) {
      _applyReactActive(el, type, _hasReacted(sid, type));
    }
  });
}
initReactButtons();

// FAB pulse starts via CSS class, stops when modal opens
</script>
